{
  "name": "@stellar-hooks/core",
  "version": "0.2.0",
  "sideEffects": false,
  "description": "Framework-agnostic Stellar / Soroban utilities — network configs, RPC helpers, XDR builders, error classes. Zero React dependency.",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./network": {
      "types": "./dist/network.d.ts",
      "import": {
        "types": "./dist/network.d.mts",
        "default": "./dist/network.mjs"
      },
      "require": {
        "types": "./dist/network.d.ts",
        "default": "./dist/network.js"
      }
    },
    "./errors": {
      "types": "./dist/errors.d.ts",
      "import": {
        "types": "./dist/errors.d.mts",
        "default": "./dist/errors.mjs"
      },
      "require": {
        "types": "./dist/errors.d.ts",
        "default": "./dist/errors.js"
      }
    },
    "./rpc": {
      "types": "./dist/rpc.d.ts",
      "import": {
        "types": "./dist/rpc.d.mts",
        "default": "./dist/rpc.mjs"
      },
      "require": {
        "types": "./dist/rpc.d.ts",
        "default": "./dist/rpc.js"
      }
    },
    "./xdr": {
      "types": "./dist/xdr.d.ts",
      "import": {
        "types": "./dist/xdr.d.mts",
        "default": "./dist/xdr.mjs"
      },
      "require": {
        "types": "./dist/xdr.d.ts",
        "default": "./dist/xdr.js"
      }
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup src/index.ts src/network.ts src/errors.ts src/rpc.ts src/xdr.ts --format cjs,esm --dts --clean",
    "dev": "tsup src/index.ts --format cjs,esm --dts --watch",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "stellar",
    "soroban",
    "rpc",
    "xdr",
    "utilities",
    "typescript",
    "framework-agnostic"
  ],
  "author": "stellar-hooks contributors",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/dark-princezz/stellar-hooks.git",
    "directory": "packages/core"
  },
  "peerDependencies": {
    "@stellar/stellar-sdk": "^13.0.0"
  },
  "devDependencies": {
    "@stellar/stellar-sdk": "17.2.1",
    "tsup": "^8.0.0",
    "typescript": "^5.4.0"
  }
}

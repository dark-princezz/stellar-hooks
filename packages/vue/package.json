{
  "name": "@stellar-hooks/vue",
  "version": "0.1.0",
  "sideEffects": false,
  "description": "Vue 3 composables for Stellar and Soroban built on framework-agnostic @stellar-hooks/core.",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts --clean",
    "dev": "tsup src/index.ts --format cjs,esm --dts --watch",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "stellar",
    "soroban",
    "vue",
    "vue3",
    "composables",
    "web3",
    "blockchain"
  ],
  "author": "stellar-hooks contributors",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/dark-princezz/stellar-hooks.git",
    "directory": "packages/vue"
  },
  "peerDependencies": {
    "@stellar-hooks/core": "^0.2.0",
    "@stellar/stellar-sdk": "^13.0.0",
    "vue": "^3.3.0"
  },
  "devDependencies": {
    "@stellar-hooks/core": "file:../core",
    "@stellar/stellar-sdk": "17.2.1",
    "tsup": "^8.0.0",
    "typescript": "^5.4.0",
    "vue": "^3.4.0"
  }
}
